%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c298874fd4aa3d04890d4f3eff36207b, type: 3}
  m_Name: Catalogo_pecas_v0
  m_EditorClassIdentifier: MontAR::MontAR.PartCatalog
  parts:
  - partId: placa_mae
    displayName: "Placa-m\xE3e"
    description: "Base da montagem: as outras pe\xE7as encaixam nela. Fica deitada no tapete."
    icon: {fileID: 21300000, guid: b1858665d96d131428ab0bacde0ee48b, type: 3}
    unitSingular: placa
    unitPlural: placas
    minQuantity: 1
    maxQuantity: 1
    defaultQuantity: 1
    models:
    - modelId: atx_generica_lga1700
      displayName: "ATX gen\xE9rica \xB7 LGA1700/AM5"
      detail: "Exemplo at\xE9 definir o kit (D5): \xE1udio HD 7.1 (codec Realtek ALC), rede 2,5 Gb/s, Wi-Fi 6E e Bluetooth 5.3, USB-C 3.2 e 6 USB-A atr\xE1s, 4 slots de RAM. O soquete acompanha a CPU."
  - partId: cpu
    displayName: Processador (CPU)
    description: "Vai no soquete; o tri\xE2ngulo dourado mostra o sentido. Intel e AMD t\xEAm etapas pr\xF3prias de CPU e cooler."
    icon: {fileID: 21300000, guid: a8faa18371b56534d9bcaeb2ebcfaccb, type: 3}
    unitSingular: unidade
    unitPlural: unidades
    minQuantity: 1
    maxQuantity: 1
    defaultQuantity: 1
    models:
    - modelId: intel_lga1700
      displayName: "Intel \xB7 soquete LGA1700"
      detail: 
    - modelId: amd_am5
      displayName: "AMD \xB7 soquete AM5"
      detail: 
  - partId: cooler
    displayName: Cooler do processador
    description: Tira o calor da CPU; o cabo vai no conector CPU_FAN.
    icon: {fileID: 21300000, guid: ac41a508b3ebd0d4ab281e4530ab51df, type: 3}
    unitSingular: unidade
    unitPlural: unidades
    minQuantity: 1
    maxQuantity: 1
    defaultQuantity: 1
    models:
    - modelId: cooler_ar_4pinos
      displayName: "Torre a ar \xB7 4 heat pipes \xB7 120 mm"
      detail: "Heat pipes s\xE3o os tubos de cobre que levam o calor da base at\xE9 as aletas: mais tubos, mais calor dissipado. Cabo de 4 pinos (PWM)."
    - modelId: cooler_box
      displayName: "Cooler box (de f\xE1brica) \xB7 sem heat pipes"
      detail: "Dissipador baixo de alum\xEDnio que vem com algumas CPUs: s\xF3 para uso leve. Cabo de 4 pinos."
    - modelId: cooler_torre_dupla
      displayName: "Torre dupla \xB7 6 heat pipes \xB7 2 fans"
      detail: "Para CPUs que esquentam mais. \xC9 alto: confira a altura m\xE1xima do gabinete. Os 2 fans ligam juntos no CPU_FAN (cabo em Y)."
  - partId: ram
    displayName: "Mem\xF3ria RAM"
    description: "Recomendado: 2 pentes iguais (dual channel). A placa aceita at\xE9 4; o roteiro indica os slots de cada caso."
    icon: {fileID: 21300000, guid: 4b103703f3e65014caebb7e4dfd3c720, type: 3}
    unitSingular: pente
    unitPlural: pentes
    minQuantity: 1
    maxQuantity: 4
    defaultQuantity: 2
    models:
    - modelId: ddr5_dimm
      displayName: "DDR5 \xB7 16 GB \xB7 5600 MT/s \xB7 CL40"
      detail: "Capacidade por pente. Frequ\xEAncia (MT/s) e lat\xEAncia (CL) mudam o desempenho, n\xE3o o encaixe: o roteiro \xE9 o mesmo."
    - modelId: ddr5_8gb_4800_cl40
      displayName: "DDR5 \xB7 8 GB \xB7 4800 MT/s \xB7 CL40"
      detail: "Capacidade por pente. Use pentes iguais (mesma capacidade, frequ\xEAncia e lat\xEAncia)."
    - modelId: ddr5_32gb_6000_cl30
      displayName: "DDR5 \xB7 32 GB \xB7 6000 MT/s \xB7 CL30"
      detail: Capacidade por pente. Para chegar a 6000 MT/s, ative o perfil XMP/EXPO na BIOS depois de montar.
  - partId: ssd
    displayName: Armazenamento
    description: 'Onde ficam o sistema e os arquivos. Cada tipo liga de um jeito: o roteiro muda com o modelo.'
    icon: {fileID: 21300000, guid: 7074859d22a9d884c9c450bb2a260e7a, type: 3}
    unitSingular: unidade
    unitPlural: unidades
    minQuantity: 0
    maxQuantity: 1
    defaultQuantity: 1
    models:
    - modelId: ssd_m2_2280_nvme
      displayName: "SSD M.2 2280 \xB7 NVMe"
      detail: "O mais r\xE1pido: encaixa direto na placa, inclinado, e prende com um parafuso. Sem cabos."
    - modelId: ssd_sata_25
      displayName: SSD SATA 2,5"
      detail: 'Liga por dois cabos: dados SATA (na placa) e energia SATA (da fonte). Mais lento que o NVMe.'
    - modelId: hd_sata_35
      displayName: "HD SATA 3,5\" \xB7 7200 rpm"
      detail: "Disco com pe\xE7as m\xF3veis: mais espa\xE7o por pre\xE7o, mais lento e fr\xE1gil a batidas. Usa os mesmos cabos do SSD SATA."
  - partId: gpu
    displayName: "Placa de v\xEDdeo"
    description: 'Opcional: vai no slot PCIe x16 de cima. O tipo define o cabo de energia.'
    icon: {fileID: 21300000, guid: ae991b5174a1c014ebb72ac6949e83fb, type: 3}
    unitSingular: unidade
    unitPlural: unidades
    minQuantity: 0
    maxQuantity: 1
    defaultQuantity: 1
    models:
    - modelId: gpu_pcie_x16
      displayName: "PCIe x16 \xB7 1 cabo PCIe 8 pinos (6+2)"
      detail: "Intermedi\xE1ria: al\xE9m do slot, recebe energia por um cabo PCIe 6+2 da fonte. Ocupa 2 slots de altura."
    - modelId: gpu_sem_cabo
      displayName: "PCIe x16 \xB7 sem cabo de energia (at\xE9 75 W)"
      detail: "De entrada: toda a energia vem do pr\xF3prio slot PCIe. N\xE3o tem conector de energia na placa."
    - modelId: gpu_12v2x6
      displayName: "PCIe x16 \xB7 conector 12V-2x6 (16 pinos)"
      detail: "Alto desempenho: um cabo \xFAnico de 16 pinos (12V-2x6/12VHPWR). Exige fonte com esse cabo ou o adaptador da placa. Ocupa 3 slots ou mais."
  - partId: fonte
    displayName: "Fonte de alimenta\xE7\xE3o"
    description: "Liga a placa pelos cabos de 24 pinos e EPS 8 pinos. Tem chave 110/220 V atr\xE1s? Escolha o modelo com chave."
    icon: {fileID: 21300000, guid: ae48b38f7e4a63f42bc7b47133eb28bc, type: 3}
    unitSingular: unidade
    unitPlural: unidades
    minQuantity: 1
    maxQuantity: 1
    defaultQuantity: 1
    models:
    - modelId: fonte_atx
      displayName: "ATX bivolt autom\xE1tica (100\u2013240 V)"
      detail: 
    - modelId: fonte_atx_chave
      displayName: ATX com chave 110/220 V
      detail: "Fonte com chave seletora de tens\xE3o: o roteiro ganha uma etapa para conferir a chave antes de ligar."
