  overlayPositionOffset: {x: 0.04239999, y: 0.0092, z: -0.177}
  overlayRotationOffset: {x: 0, y: 0, z: 0}
  validationType: 0
  checklistItems:
  - Pentes nos slots A2, B2 e A1
  - Chanfro alinhado com a chave de cada slot
  - "Travas fechadas nos tr\xEAs slots"
